{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/automation-tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/nudges",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/segment-rebuild",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/process-locks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-trials",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/auto-payouts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/process-dunning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/onboarding-drip",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/process-broadcasts",
      "schedule": "*/10 * * * *"
    }
  ]
}
