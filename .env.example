# ============================================================
# Promptly — Environment Variables
# Copy this file to .env and fill in your values.
# VITE_ prefix = exposed to the browser. Never put secrets there.
# ============================================================

# ── App ─────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
PORT=3001

# ── Firebase (Client — exposed to browser) ──────────────────
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abc123"
VITE_FIREBASE_DATABASE_ID="(default)"

# ── Firebase (Server — never expose to browser) ─────────────
# Base64-encoded service account JSON.
# Generate: base64 -i service-account.json (macOS/Linux)
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT="eyJ0eXBlIjoic2VydmljZV9hY2NvdW50..."

# ── Hostinger FTP Storage ────────────────────────────────────
# Files are uploaded via FTP to Hostinger and served as static URLs.
# Config can also be stored in Firestore at configs/ftp (takes priority over env vars).
FTP_SERVER="ftp.yourdomain.com"
FTP_USERNAME="your_ftp_username"
FTP_PASSWORD="your_ftp_password"
FTP_FOLDER="promptly/public/"
# Public URL base where uploaded files are accessible
FTP_ENDPOINT="https://yourdomain.com/promptly/public/"

# ── Payments — Cashfree ──────────────────────────────────────
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox"
# CASHFREE_ENV options: "sandbox" | "production"

# ── Payments — Stripe (optional) ────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Payments — PayPal (optional) ────────────────────────────
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_SECRET_KEY="your_paypal_secret_key"
PAYPAL_ENV="sandbox"
# PAYPAL_ENV options: "sandbox" | "live"

# ── Email / SMTP ─────────────────────────────────────────────
EMAIL_PROVIDER="smtp"
# EMAIL_PROVIDER options: "smtp" | "sendgrid" | "mailgun"
FROM_NAME="Promptly"
FROM_EMAIL="noreply@yourdomain.com"
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your_smtp_password"

# ── AI Models (Backend proxy — never expose to browser) ──────
GEMINI_API_KEY="AIza..."
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
GEMINI_TEXT_MODEL="gemini-2.5-flash-lite"
GEMINI_IMAGE_MODEL="gemini-2.0-flash"

OPENAI_API_KEY="sk-..."
OPENAI_CHAT_MODEL="gpt-4.1-mini"

ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_CHAT_MODEL="claude-sonnet-4-20250514"

# ── AI Models (Frontend dev fallback — sandbox/dev only) ─────
# These bypass the /api/ai/* proxy and call AI APIs directly from the browser.
# Remove in production — use the backend proxy instead.
VITE_GEMINI_API_KEY="AIza..."
VITE_GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
