# ============================================================
# Promptly — Environment Variables
# Copy this file to .env and fill in your values.
# VITE_ prefix = exposed to the browser. Never put secrets there.
# ============================================================

# ── App ─────────────────────────────────────────────────────
# Set APP_URL to your production domain in Vercel env vars (e.g. https://promptly.ai).
# On Vercel, VERCEL_URL is auto-injected as a fallback (no manual setup needed).
# Also add APP_URL as a GitHub Actions secret for cron job curl calls.
APP_URL="http://localhost:5173"
APP_NAME="Promptly"
PORT=3001
# Optional: language prefix for email links. Defaults to "en".
# DEFAULT_LANG="en"
# Comma-separated list of emails that receive admin role on login.
VITE_ADMIN_EMAILS="admin@yourapp.com"

# ── Firebase (Client — exposed to browser) ──────────────────
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:abc123"
# Use "(default)" if you have not created a named Firestore database.
VITE_FIREBASE_DATABASE_ID="(default)"

# ── Firebase (Server — never expose to browser) ─────────────
# Base64-encoded service account JSON.
# Generate: base64 -i service-account.json (macOS/Linux)
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT="eyJ0eXBlIjoic2VydmljZV9hY2NvdW50..."

# ── Cron Job Security ────────────────────────────────────────
# Shared secret between GitHub Actions cron jobs and this server.
# Set the same value in both this file and your GitHub Actions secrets.
CRON_SECRET="your-cron-secret"
# VITE_CRON_SECRET is used by the admin system-health page to trigger cron jobs manually.
# Should match CRON_SECRET. Safe to expose since admin page is protected by auth.
VITE_CRON_SECRET="your-cron-secret"

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Used by api/index.ts (Vercel entry point).
CORS_ORIGIN="http://localhost:5173"

# ── Hostinger FTP Storage ────────────────────────────────────
# Files are uploaded via FTP to Hostinger and served as static URLs.
# Config can also be stored in Firestore at configs/storage (takes priority over env vars).
FTP_SERVER="ftp.yourdomain.com"
FTP_USERNAME="your_ftp_username"
FTP_PASSWORD="your_ftp_password"
FTP_FOLDER="promptly/public/"
# Public-facing base URL where uploaded files are accessible via HTTP.
FTP_PUBLIC_URL="https://yourdomain.com/promptly/public"

# ── Payments — Cashfree ──────────────────────────────────────
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_ENV="sandbox"
# CASHFREE_ENV options: "sandbox" | "production"
# Optional: Cashfree webhook signature verification secret.
# Can also be stored in Firestore at configs/payment.cashfree.webhookSecret.
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"

# ── Payments — Stripe (optional) ────────────────────────────
# STRIPE_SECRET_KEY is used server-side. The other two are not yet wired up.
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Payments — PayPal (optional) ────────────────────────────
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_client_secret"
PAYPAL_ENV="sandbox"
# PAYPAL_ENV options: "sandbox" | "live"

# ── Email / SMTP ─────────────────────────────────────────────
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@yourdomain.com"
SMTP_PASS="your_smtp_password"
# Sender address and display name shown in outgoing emails.
SMTP_FROM_EMAIL="noreply@yourdomain.com"
SMTP_FROM_NAME="Promptly"

# ── Frontend ─────────────────────────────────────────────────
# Optional: override the API base URL in the browser. Defaults to "/api".
# VITE_API_URL="/api"

# ── Dev / Build Flags ────────────────────────────────────────
# Set to "true" to disable Vite HMR (e.g. in AI-assisted coding environments).
# DISABLE_HMR=true

# ── Platform Auto-injected (do NOT set manually) ─────────────
# Vercel injects these automatically — never add them to Vercel env vars:
#   VERCEL_URL      hostname of deployment, no https:// (used as APP_URL fallback)
#   VERCEL_ENV      "production" | "preview" | "development"
#   NODE_ENV        set by runtime
#
# GitHub Actions secrets required (set in repo Settings → Secrets):
#   APP_URL         production URL, same value as APP_URL above
#   CRON_SECRET     same value as CRON_SECRET above
#   ENV_FILE        full contents of your production .env (for Hostinger deploy)
#   FTP_SERVER / FTP_USERNAME / FTP_PASSWORD  (for Hostinger deploy)

# ── AI Models (Frontend dev fallback — sandbox/dev only) ─────
# These bypass the /api/ai/* proxy and call AI APIs directly from the browser.
# Remove in production — use the backend proxy instead.
VITE_GEMINI_API_KEY="AIza..."
VITE_GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
