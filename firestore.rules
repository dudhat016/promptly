rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isPro(userId) {
      return getUserData(userId).subscriptionStatus == 'pro';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'calmingsound016@gmail.com' ||
        request.auth.token.email == 'admin@promptly.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'subscriptionStatus']) &&
             data.keys().size() <= 15 &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             data.subscriptionStatus in ['free', 'pro', 'enterprise'];
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'description', 'isPaid', 'creatorId']) &&
             data.keys().size() <= 20 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.isPaid is bool &&
             (data.creatorId == request.auth.uid || isAdmin() || (data.creatorId == 'system' && isAdmin()));
    }

    // --- Configurations (Marketing & Monetization) ---
    match /configs/{configId} {
      // Allow everyone to read marketing config (for Pixel/GA/AdMob IDs)
      allow read: if configId == 'marketing' || isAdmin();
      // Only admins can modify configurations
      allow write: if isAdmin();
    }

    // --- Collection Routes ---

    // Categories are public
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
    }

    // User profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if true; // Allow searching for creators by referralCode
      allow create: if isOwner(userId) && isValidUser(incoming());
      // Admins can update roles/subscriptions
      allow update: if isOwner(userId) && 
                   !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['role', 'uid', 'email', 'createdAt']) || 
                   (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['lastActiveAt', 'lastCreditsRewardAt', 'credits', 'totalUsedCredits', 'referralCode', 'affinityProfile', 'unlockedPrompts'])) || (isAdmin());
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true; // Metadata is public, content is blurred in UI until unlocked

      allow create: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com' || (isSignedIn() && isEmailVerified() && isValidPrompt(incoming()) && incoming().createdAt == request.time);
      allow update: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com' || (isSignedIn() && isEmailVerified() && isValidPrompt(incoming()) && incoming().updatedAt == request.time) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'likesCount']));
      allow delete: if isAdmin() || isOwner(existing().creatorId);

      // Versions subcollection
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/prompts/$(promptId)).data.creatorId) || isAdmin();
      }

      // Secret Content subcollection (The Real Formula)
      match /private/content {
        allow read: if isAdmin() || 
                    (isSignedIn() && isPro(request.auth.uid)) || 
                    (isSignedIn() && promptId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedPrompts);
        allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
      }
    }

    // Favorites
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isOwner(userId);
    }

    // Referrals
    match /referrals/{referralId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // Email Notifications & Templates
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
    match /templates/{templateId} {
      allow read: if isSignedIn(); // Allow reading for system services
      allow write: if isAdmin();
    }
    match /tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Pricing & Config
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/access_levels {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New Centralized Platform Configuration
    match /configs/{configId} {
      // General branding is public, sensitive settings (SMTP/Email) are Admin-only
      allow read: if (configId == 'global') || isAdmin();
      allow write: if isAdmin();
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit logs — append-only by admins, immutable once written
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Marketing & CRM
    match /marketing_contacts/{id} {
      allow create: if true;
      allow read, update: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'learnwithdudhat016@gmail.com'));
      allow delete: if isAdmin();
    }
    match /marketing_tags/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_segments/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_automations/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_activities/{id} {
      allow read, write: if isAdmin();
    }

    // Email Logs
    match /email_logs/{id} {
      allow read, write: if isAdmin();
    }

    // Models are public
    match /models/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tags are public, writable by signed-in users (to create new tags for prompts)
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admins list (readonly for everyone for lookup, write only via admin or bootstrap email)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'calmingsound016@gmail.com');
    }

    // Blog Posts
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Pages SEO
    match /site_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Credits History
    match /credits_history/{id} {
      allow read: if true; // Public for social proof popups
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Asset Vault (Images stored on Hostinger)
    match /assets/{assetId} {
      allow read: if true; // Publicly accessible via the site
      allow write: if isAdmin();
    }
  }
}
