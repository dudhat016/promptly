rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isPro(userId) {
      return getUserData(userId).subscriptionStatus == 'pro';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'calmingsound016@gmail.com' ||
        request.auth.token.email == 'admin@promptly.com' ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff();
    }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'subscriptionStatus']) &&
             data.keys().size() <= 15 &&
             (data.uid == request.auth.uid || isAdmin()) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['user', 'admin'] &&
             data.subscriptionStatus in ['free', 'pro', 'enterprise'];
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'description', 'isPaid', 'creatorId']) &&
             data.keys().size() <= 20 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.isPaid is bool &&
             (data.creatorId == request.auth.uid || isAdmin() || (data.creatorId == 'system' && isAdmin()));
    }

    // --- Configurations (Marketing & Monetization) ---
    match /configs/{configId} {
      // marketing/payment/global: public; staff_roles: signed-in; rest: admin only
      allow read: if configId == 'marketing' || configId == 'payment' || configId == 'access_levels' || configId == 'staff_roles' || isSignedIn() && configId == 'global' || isAdmin();
      // Only admins can modify configurations
      allow write: if isAdmin();
    }

    // --- Collection Routes ---

    // Badge definitions — public read so clients can fetch without auth; admin write
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories are public
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
    }

    // User profiles
    match /users/{userId} {
      allow get: if true;
      allow list: if true; // Allow searching for creators by referralCode
      allow create: if isOwner(userId) && isValidUser(incoming());
      // Admins can update roles/subscriptions
      allow update: if isOwner(userId) &&
                   !request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['role', 'uid', 'email', 'createdAt']) ||
                   (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['lastActiveAt', 'lastCreditsRewardAt', 'credits', 'totalUsedCredits', 'referralCode', 'affinityProfile', 'unlockedPrompts'])) ||
                   (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])) ||
                   (isAdmin());
    }

    // Prompts
    match /prompts/{promptId} {
      allow read: if true; // Metadata is public, content is blurred in UI until unlocked

      // Creators can submit (status must start as 'pending'); admins can create approved prompts directly
      allow create: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com' ||
                    (isSignedIn() && isEmailVerified() && isValidPrompt(incoming()) &&
                     incoming().createdAt == request.time &&
                     (!incoming().keys().hasAny(['status']) || incoming().status == 'pending'));

      // Admins can change status/moderationStatus; creators can update their own pending prompts; anyone can increment viewsCount/likesCount/reportCount
      allow update: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com' ||
                    (isSignedIn() && isEmailVerified() && isValidPrompt(incoming()) && incoming().updatedAt == request.time &&
                     existing().creatorId == request.auth.uid && (existing().status == 'pending' || existing().status == 'rejected')) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'likesCount'])) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'moderationStatus'])) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['copiesCount'])) ||
                    (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCount', 'avgRating']));
      allow delete: if isAdmin() || isOwner(existing().creatorId);

      // Reviews subcollection — public read; owner create/delete; admin moderate
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update: if isAdmin() ||
                      (isSignedIn() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment', 'rating']));
        allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      }

      // Versions subcollection
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isOwner(get(/databases/$(database)/documents/prompts/$(promptId)).data.creatorId) || isAdmin();
      }

      // Secret Content subcollection (The Real Formula)
      match /private/content {
        allow read: if isAdmin() || 
                    (isSignedIn() && isPro(request.auth.uid)) || 
                    (isSignedIn() && promptId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.unlockedPrompts);
        allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
      }
    }

    // Favorites
    match /users/{userId}/favorites/{favoriteId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/saved_prompts/{promptId} {
      allow read, write: if isOwner(userId);
    }

    // Referrals
    match /referrals/{referralId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow create: if isSignedIn();
    }

    // Affiliate commission ledger — users read their own rows; admin reads all
    match /referral_commissions/{id} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.referrerId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && request.auth != null);
      allow create: if false; // written server-side only
      allow update: if isAdmin(); // lock-period processing
      allow delete: if false;
    }

    // Email Notifications & Templates
    match /notifications/{notificationId} {
      allow read, write: if isAdmin();
    }
    match /templates/{templateId} {
      allow read: if isSignedIn(); // Allow reading for system services
      allow write: if isAdmin();
    }
    match /tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Pricing & Config
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/access_levels {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/global {
      allow read: if true;
      allow write: if isAdmin();
    }

    // New Centralized Platform Configuration (duplicate block — kept for clarity, merged into rule above)
    match /configs/{configId} {
      allow read: if configId == 'global' || configId == 'marketing' || configId == 'payment' || configId == 'staff_roles' || isAdmin();
      allow write: if isAdmin();
    }

    // Payouts
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit logs — append-only by admins/staff, immutable once written
    match /audit_logs/{logId} {
      allow read: if isAdminOrStaff();
      allow create: if isAdminOrStaff();
      allow update, delete: if false;
    }

    // Changelogs — public read, admin write
    match /changelogs/{entryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials — public read (landing page), admin write
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Marketing & CRM
    match /marketing_contacts/{id} {
      allow create: if true;
      allow read, update: if isAdmin() || (isSignedIn() && (resource.data.userId == request.auth.uid || request.auth.token.email == 'learnwithdudhat016@gmail.com'));
      allow delete: if isAdmin();
    }
    match /marketing_tags/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_segments/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_automations/{id} {
      allow read, write: if isAdmin();
    }
    match /marketing_activities/{id} {
      allow read, write: if isAdmin();
    }

    // Email Logs — admin reads/manages; backend writes via Admin SDK (bypasses rules)
    match /email_logs/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isSignedIn();
    }

    // Automation flow instances — admin manages via admin panel
    match /flow_instances/{id} {
      allow read, write: if isAdmin();
    }

    // Models are public
    match /models/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tags are public, writable by signed-in users (to create new tags for prompts)
    match /tags/{tagId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Admins list (readonly for everyone for lookup, write only via admin or bootstrap email)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.token.email == 'calmingsound016@gmail.com');
    }

    // Blog Posts
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Pages SEO
    match /site_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || request.auth.token.email == 'learnwithdudhat016@gmail.com';
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Credits History
    match /credits_history/{id} {
      allow read: if true; // Public for social proof popups
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Asset Vault (Images stored on Hostinger)
    match /assets/{assetId} {
      allow read: if true; // Publicly accessible via the site
      allow write: if isAdmin();
    }

    // Media Library — tracked image assets uploaded via FTP
    match /media_assets/{assetId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Orders & Transactions
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Site Content (Legal Pages, FAQs)
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin();
    }

    // AI Creations (image generations stored per user)
    match /creations/{creationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Coupons — anyone can read for validation; only admin writes
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupon_redemptions/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // Prompt Reports — any user (including anonymous) can create; admin/staff manage
    match /prompt_reports/{reportId} {
      allow read: if isAdminOrStaff();
      allow create: if true; // anonymous + logged-in users can report
      allow update: if isAdminOrStaff();
      allow delete: if isAdmin();
    }

    // Prompt Collections — private by default; public collections readable by anyone
    match /collections/{collectionId} {
      allow read: if isAdmin() ||
                  (isSignedIn() && resource.data.userId == request.auth.uid) ||
                  (resource.data.isPublic == true);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // Per-user notifications (approval/rejection/warning)
    match /users/{userId}/notifications/{notifId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || isSignedIn(); // system writes via SDK
      allow update: if isOwner(userId); // user can mark as read
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
